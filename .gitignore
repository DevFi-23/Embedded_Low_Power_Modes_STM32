# STM32CubeIDE build output (Debug/Release configurations)
/*/*/Debug/
/*/*/Release/

# STM32CubeIDE / Eclipse workspace metadata
.metadata/
RemoteSystemsTempFiles/

# Temporary editor and operating system files
*.tmp
*.swp
*.swo
~$*
Thumbs.db
Desktop.ini
.DS_Store

# Local environment files and private keys
.env
.env.*
!.env.example
!.env.sample
*.key
*.p12
*.pfx

# Keep project/board configuration (.ioc, .project, .cproject, linker
# scripts, startup files), bundled Drivers, reports,
# extracted images, and evidence. Do not ignore PDFs or firmware globally.
